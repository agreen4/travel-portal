---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
}
const { title, description, noindex = false } = Astro.props;
const pw = import.meta.env.PUBLIC_TRIP_PASSWORD ?? '';
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title} — Andrew & Kim Travel</title>
  {description && <meta name="description" content={description} />}
  {noindex && <meta name="robots" content="noindex, nofollow" />}
</head>
<body>
  <header class="site-header">
    <a href="/" class="site-name">Travel</a>
  </header>
  <main>
    <slot />
  </main>
  <footer class="site-footer">
    <p class="label">Andrew Greenlee</p>
  </footer>

  <button class="private-lock-btn" id="private-lock-btn" aria-label="Toggle private details">🔒 Details</button>

  <script src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script>
  <script>
    if (window.netlifyIdentity) {
      window.netlifyIdentity.on("init", user => {
        if (!user) {
          window.netlifyIdentity.on("login", () => { document.location.href = "/admin/"; });
        }
      });
    }
  </script>

  <script define:vars={{ pw }}>
    const STORAGE_KEY = 'travel-portal-pw';

    function applyUnlocked() {
      document.body.classList.add('private-unlocked');
      const btn = document.getElementById('private-lock-btn');
      if (btn) {
        btn.textContent = '🔓 Details';
        btn.setAttribute('aria-label', 'Hide private details');
      }
    }

    function applyLocked() {
      document.body.classList.remove('private-unlocked');
      const btn = document.getElementById('private-lock-btn');
      if (btn) {
        btn.textContent = '🔒 Details';
        btn.setAttribute('aria-label', 'Show private details');
      }
    }

    // Restore from localStorage on page load
    if (pw && localStorage.getItem(STORAGE_KEY) === pw) {
      applyUnlocked();
    }

    document.getElementById('private-lock-btn')?.addEventListener('click', () => {
      if (document.body.classList.contains('private-unlocked')) {
        localStorage.removeItem(STORAGE_KEY);
        applyLocked();
      } else {
        if (!pw) return;
        const entered = prompt('Enter password to view private details:');
        if (entered === pw) {
          localStorage.setItem(STORAGE_KEY, pw);
          applyUnlocked();
        } else if (entered !== null) {
          alert('Incorrect password.');
        }
      }
    });
  </script>
</body>
</html>
