---
// src/components/MealBlock.astro
interface Props {
  id: string;
  time?: string;
  restaurant: string;
  dish?: string;
  notes?: string;
  url?: string;
}
const { id, time, restaurant, dish, notes, url } = Astro.props;
---

<div class="meal" data-activity-id={id}>
  {time && <p class="meal__time label">{time}</p>}
  <div class="meal__content">
    <span class="meal__icon" aria-hidden="true">🍽</span>
    <div>
      {url
        ? <a href={url} target="_blank" rel="noopener" class="meal__name">{restaurant}</a>
        : <p class="meal__name">{restaurant}</p>
      }
      {dish && <p class="meal__dish">{dish}</p>}
      {notes && <p class="meal__notes">{notes}</p>}
      <button class="suggest-trigger label" data-for={id} aria-label={`Add note about ${restaurant}`}>+ note</button>
    </div>
  </div>
</div>

<style>
  .meal { display: flex; gap: 0.75rem; margin-bottom: 1.25rem; }
  .meal__time { min-width: 60px; padding-top: 2px; }
  .meal__content { display: flex; gap: 0.5rem; flex: 1; }
  .meal__icon { font-size: 0.9rem; padding-top: 2px; }
  .meal__name { font-weight: 600; font-size: 0.95rem; margin-bottom: 0.15rem; display: block; }
  .meal__dish { font-style: italic; font-size: 0.875rem; margin-bottom: 0.15rem; color: var(--text-muted); }
  .meal__notes { font-size: 0.85rem; color: var(--text-muted); }
  .suggest-trigger {
    display: none;
    margin-top: 0.4rem;
    background: none;
    border: 1px dashed var(--border);
    border-radius: 12px;
    padding: 2px 10px;
    cursor: pointer;
    color: var(--text-muted);
  }
  :global(.suggest-active) .suggest-trigger { display: inline-block; }
  .suggest-trigger:hover { border-color: var(--accent); color: var(--accent); }
</style>
