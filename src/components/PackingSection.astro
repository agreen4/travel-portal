---
// src/components/PackingSection.astro
interface Item {
  label: string;
}

interface Props {
  name: string;
  items: Item[];
  tripSlug: string;
}

const { name, items, tripSlug } = Astro.props;
---

<div class="packing-section">
  <h3 class="section-heading">{name}</h3>
  <ul class="item-list">
    {items.map(item => (
      <li class="item">
        <label class="item-label">
          <input
            type="checkbox"
            class="item-check"
            data-key={`${tripSlug}::${name}::${item.label}`}
          />
          <span class="item-text">{item.label}</span>
        </label>
      </li>
    ))}
  </ul>
</div>

<style>
  .packing-section {
    border: 1px solid var(--border);
    border-radius: 3px;
    padding: 1.25rem 1.5rem;
    margin-bottom: 1rem;
  }

  .section-heading {
    margin-bottom: 0.75rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--border);
  }

  .item-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .item-label {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    cursor: pointer;
    font-size: 0.95rem;
    line-height: 1.4;
    transition: color 0.1s;
  }

  .item-check {
    flex-shrink: 0;
    width: 16px;
    height: 16px;
    cursor: pointer;
    accent-color: var(--accent);
  }

  .item-label:has(.item-check:checked) .item-text {
    color: var(--text-light);
    text-decoration: line-through;
  }

  @media print {
    .packing-section {
      break-inside: avoid;
      border: none;
      padding: 0 0 1rem 0;
    }

    .item-check {
      appearance: none;
      -webkit-appearance: none;
      border: 1.5px solid #333;
      border-radius: 2px;
      width: 12px;
      height: 12px;
    }

    .item-label:has(.item-check:checked) .item-text {
      color: inherit;
      text-decoration: none;
    }
  }
</style>
