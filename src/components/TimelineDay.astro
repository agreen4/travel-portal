---
// src/components/TimelineDay.astro
import { formatDay } from '../utils/format-date';
import ActivityBlock from './ActivityBlock.astro';
import MealBlock from './MealBlock.astro';

interface Activity { id: string; time?: string; name: string; description?: string; url?: string; photo?: string; confirmation?: string; }
interface Meal { id: string; time?: string; restaurant: string; dish?: string; notes?: string; url?: string; confirmation?: string; }
interface Accommodation { name: string; url?: string; confirmation?: string; }
interface Day {
  date: Date;
  location: string;
  title?: string;
  notes?: string;
  accommodation?: Accommodation;
  activities: Activity[];
  meals: Meal[];
}

interface Props {
  day: Day;
  tripSlug: string;
  isPrivate: boolean;
}
const { day, tripSlug, isPrivate } = Astro.props;
const locationId = day.location.toLowerCase().replace(/\s+/g, '-');

function parseTime(t: string | undefined): number {
  if (!t) return Infinity;
  const upper = t.toUpperCase();
  const pm = upper.includes('PM');
  const am = upper.includes('AM');
  const cleaned = upper.replace(/[APM\s]/g, '');
  const [h, m = '0'] = cleaned.split(':');
  let hours = parseInt(h, 10);
  if (pm && hours !== 12) hours += 12;
  if (am && hours === 12) hours = 0;
  return hours * 60 + parseInt(m, 10);
}

const items = [
  ...day.activities.map(a => ({ ...a, type: 'activity' as const })),
  ...day.meals.map(m => ({ ...m, type: 'meal' as const })),
].sort((a, b) => parseTime(a.time) - parseTime(b.time));
---

<div class="day" id={locationId} data-date={day.date.toISOString().slice(0, 10)}>
  <div class="day__node">
    <div class="day__dot"></div>
  </div>
  <div class="day__content">
    <div class="day__header">
      <p class="label day__date">{formatDay(day.date)}</p>
      <h2 class="day__location">{day.location}</h2>
      {day.title && <p class="day__title">{day.title}</p>}
    </div>

    {day.notes && <p class="day__notes">{day.notes}</p>}

    {day.accommodation && (
      <div class="accommodation">
        <span class="label">🏨 </span>
        {day.accommodation.url
          ? <a href={day.accommodation.url} target="_blank" rel="noopener">{day.accommodation.name}</a>
          : <span>{day.accommodation.name}</span>
        }
        {day.accommodation.confirmation && (
          <span class="accommodation__confirmation private-field"> · Conf: {day.accommodation.confirmation}</span>
        )}
      </div>
    )}

    {items.map(item =>
      item.type === 'activity'
        ? <ActivityBlock {...item} />
        : <MealBlock {...item} />
    )}

    <div class="day__diary">
      <slot name="diary" />
    </div>
  </div>
</div>

<style>
  .day {
    display: grid;
    grid-template-columns: 24px 1fr;
    gap: 1rem;
    margin-bottom: 3rem;
    position: relative;
    scroll-margin-top: 90px;
  }
  .day__node { display: flex; flex-direction: column; align-items: center; }
  .day__dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--accent);
    border: 2px solid var(--bg);
    box-shadow: 0 0 0 1px var(--accent);
    flex-shrink: 0;
    margin-top: 6px;
  }
  .day__content { padding-bottom: 1rem; }
  .day__date { margin-bottom: 0.2rem; }
  .day__location { margin-bottom: 0.2rem; font-size: 1.25rem; }
  .day__title { font-size: 0.85rem; color: var(--text-muted); font-family: var(--font-sans); margin-bottom: 0.75rem; }
  .day__notes { font-style: italic; color: var(--text-muted); margin-bottom: 1rem; font-size: 0.9rem; }
  .accommodation {
    font-family: var(--font-sans);
    font-size: 0.8rem;
    margin-bottom: 1rem;
    color: var(--text-muted);
  }
  .accommodation__confirmation { font-size: 0.75rem; }
  .day__diary {
    margin-top: 1.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
    font-size: 0.9rem;
    line-height: 1.7;
    color: var(--text);
  }
  .day__diary:empty { display: none; }
  .day--current .day__dot {
    width: 14px;
    height: 14px;
    margin-top: 4px;
    box-shadow: 0 0 0 3px var(--accent);
  }
</style>
