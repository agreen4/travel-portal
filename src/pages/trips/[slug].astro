---
// src/pages/trips/[slug].astro
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import TripHero from '../../components/TripHero.astro';
import TripStats from '../../components/TripStats.astro';
import JumpNav from '../../components/JumpNav.astro';
import TimelineDay from '../../components/TimelineDay.astro';
import SidePanel from '../../components/SidePanel.astro';

export async function getStaticPaths() {
  const trips = await getCollection('trips', ({ data }) => data.visibility !== 'private');
  return trips.map(trip => ({
    params: { slug: trip.id },
    props: { trip },
  }));
}

const { trip } = Astro.props;
const { title, description, visibility, days, pre_trip_input, cover_photo, destinations, date_start, date_end } = trip.data;

// suggestMode is always false at build time for static output.
// Client-side JS below detects ?suggest=true and adds .suggest-active to body.
const noindex = visibility === 'unlisted';
const isPrivate = visibility === 'private';
---

<BaseLayout {title} {description} {noindex}>
  <TripHero {title} {description} {cover_photo} {destinations} {date_start} {date_end} />
  <TripStats {days} />
  <JumpNav {days} />

  <div class="trip-body" id="trip-body">
    <div class="timeline">
      {days.map(day => (
        <TimelineDay
          {day}
          preInput={pre_trip_input}
          suggestMode={false}
          tripSlug={trip.id}
          {isPrivate}
        />
      ))}
    </div>

    <SidePanel
      preInput={pre_trip_input}
      suggestMode={false}
      tripSlug={trip.id}
    />
  </div>
</BaseLayout>

<script>
  // Activate suggest mode client-side if ?suggest=true
  if (new URLSearchParams(window.location.search).get('suggest') === 'true') {
    document.body.classList.add('suggest-active');
    document.getElementById('trip-body')?.classList.add('trip-body--suggest');
  }
  // Show the side panel if there are notes (has-notes class on body)
  const panel = document.getElementById('side-panel');
  if (panel) {
    const hasNotes = panel.querySelectorAll('.note').length > 0;
    if (hasNotes) document.body.classList.add('has-notes');
  }
</script>
